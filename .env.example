# Reference only: npm start does not automatically load this file.
# Set these variables in the process environment before starting the app.
ESQUIE_PORT=4317
# Optional absolute local directory for either host; blank keeps its default.
# Web defaults under the user's home; desktop under LOCALAPPDATA.
# Keep it outside this repository, shared folders, OneDrive, and SharePoint.
ESQUIE_DATA_DIR=
# Optional JSON array of additional absolute cloud-sync roots to reject.
ESQUIE_SYNC_ROOTS=[]
# No credentials, owner identity, tenant IDs, or source bindings belong here.
# External integrations remain disconnected; this file cannot enable them.
